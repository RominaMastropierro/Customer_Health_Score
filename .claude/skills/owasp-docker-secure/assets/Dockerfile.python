# syntax=docker/dockerfile:1.7
# Fijar por tag Y digest. Obtener digest: docker buildx imagetools inspect python:3.12-slim-bookworm  [#0, #9]
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:<PIN_ME>

# ---------- builder ----------
FROM ${PYTHON_IMAGE} AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
# Credenciales de índices privados, si las hay, mediante secreto de BuildKit (nunca ARG/ENV)  [#13]
RUN pip install -r requirements.txt

# ---------- runtime ----------
FROM ${PYTHON_IMAGE} AS runtime
LABEL org.opencontainers.image.source="<REPO_URL>" \
      org.opencontainers.image.version="<VERSION>"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH="/opt/venv/bin:$PATH"

# Usuario dedicado sin privilegios, IDs numéricos fijos, sin shell ni home  [#2]
RUN groupadd --system --gid 10001 app \
 && useradd  --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 . .

USER 10001:10001
# Puerto no privilegiado: no hace falta la capability NET_BIND_SERVICE  [#3]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).status==200 else 1)"]
# Forma exec para que las señales lleguen al proceso
ENTRYPOINT ["python", "-m", "app"]
